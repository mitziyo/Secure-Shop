<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{csrfToken}}">
    <title>{{product.name}} - SecureShop Elite</title>
    {{> elite_head}}
</head>
<body class="elite">
    {{> elite_header nav="catalog"}}

    <main class="ex-container ex-page">
        <nav class="ex-breadcrumb" aria-label="Breadcrumb">
            <a href="/products">Catalog</a>
            <span class="sep">/</span>
            <a href="/products?category={{urlEncode product.category}}">{{product.category}}</a>
            <span class="sep">/</span>
            <span aria-current="page">{{product.name}}</span>
        </nav>

        <div class="ex-detail">
            <div class="ex-panel ex-detail__media">
                {{#if product.image_url}}
                    <img src="{{product.image_url}}" alt="{{product.name}}">
                {{else}}
                    <span class="msi ex-card__noimg">inventory_2</span>
                {{/if}}
                <span class="ex-card__sku">SKU: {{skuHex product.id}}</span>
            </div>

            <section class="ex-panel ex-detail__info">
                <div class="ex-actions-row">
                    <span class="ex-chip {{#if (eq product.category "Books")}}ex-chip--cyan{{/if}}">{{product.category}}</span>
                    {{#if (gt product.stock_quantity 0)}}
                        <span class="ex-stock {{#if (lt product.stock_quantity 20)}}is-low{{/if}}"><span class="ex-dot"></span>IN STOCK</span>
                    {{else}}
                        <span class="ex-status ex-status--danger">OUT OF STOCK</span>
                    {{/if}}
                </div>

                <h1 class="ex-detail__title">{{product.name}}</h1>
                <p class="ex-detail__desc">{{product.description}}</p>
                <p class="ex-detail__price">${{formatPrice product.price}}</p>

                <dl class="ex-specs">
                    <dt>SKU</dt><dd>{{skuHex product.id}}</dd>
                    <dt>Category</dt><dd>{{product.category}}</dd>
                    <dt>Available</dt><dd><span id="stock-left">{{product.stock_quantity}}</span> units</dd>
                </dl>

                {{#if user}}
                    {{#if (gt product.stock_quantity 0)}}
                    <div class="ex-buy">
                        <div class="ex-qty">
                            <button type="button" data-step="-1" aria-label="Decrease quantity"><span class="msi">remove</span></button>
                            <input type="number" id="quantity" value="1" min="1" max="{{product.stock_quantity}}" aria-label="Quantity">
                            <button type="button" data-step="1" aria-label="Increase quantity"><span class="msi">add</span></button>
                        </div>
                        <button type="button" class="ex-btn ex-btn--solid ex-btn--lg" id="add-to-cart" data-product-id="{{product.id}}">
                            <span class="msi">add_shopping_cart</span>ADD TO CART
                        </button>
                    </div>
                    {{/if}}
                {{else}}
                    <div class="ex-alert ex-alert--info">
                        <span class="msi">lock</span>
                        <span>Please <a href="/auth/login"><strong>login</strong></a> to add items to your cart.</span>
                    </div>
                {{/if}}

                {{#if (eq user.role "admin")}}
                <div class="ex-admin-actions">
                    <a href="/products/admin/{{product.id}}/edit" class="ex-btn ex-btn--cyan"><span class="msi">edit</span>EDIT PRODUCT</a>
                    <form action="/products/admin/{{product.id}}/delete" method="POST" data-confirm="Are you sure you want to delete this product?">
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">
                        <button type="submit" class="ex-btn ex-btn--danger"><span class="msi">delete</span>DELETE</button>
                    </form>
                </div>
                {{/if}}
            </section>
        </div>
    </main>

    {{> elite_footer}}

    <script>
        (function () {
            const quantity = document.getElementById('quantity');
            const addButton = document.getElementById('add-to-cart');
            if (!quantity || !addButton) return;

            const clamp = (value) => Math.min(Math.max(value, 1), parseInt(quantity.max, 10) || 1);
            document.querySelectorAll('[data-step]').forEach(button => {
                button.addEventListener('click', () => {
                    quantity.value = clamp((parseInt(quantity.value, 10) || 1) + parseInt(button.dataset.step, 10));
                });
            });

            addButton.addEventListener('click', async () => {
                const qty = clamp(parseInt(quantity.value, 10) || 1);
                quantity.value = qty;
                addButton.disabled = true;
                try {
                    const response = await fetch('/cart/add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'csrf-token': getCsrfToken()
                        },
                        credentials: 'include',
                        body: JSON.stringify({ product_id: parseInt(addButton.dataset.productId, 10), quantity: qty })
                    });
                    const data = await response.json().catch(() => ({}));
                    if (response.ok) {
                        updateCartCount(data.itemCount);
                        // Adding to cart reserves stock server-side
                        const left = Math.max(parseInt(quantity.max, 10) - qty, 0);
                        quantity.max = left;
                        quantity.value = 1;
                        document.getElementById('stock-left').textContent = left;
                        if (left === 0) addButton.closest('.ex-buy').remove();
                        exToast(qty + ' item(s) added to cart');
                    } else {
                        exToast(data.message || 'Error adding to cart', true);
                    }
                } catch (error) {
                    exToast('Error adding to cart', true);
                } finally {
                    addButton.disabled = false;
                }
            });
        })();
    </script>
</body>
</html>
