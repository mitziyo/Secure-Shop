<header class="ex-header">
  <div class="ex-container ex-header__inner">
    <div class="ex-header__left">
      <a class="ex-brand" href="/">
        <span class="ex-brand__mark"><img src="/images/logo.svg" alt="" width="24" height="24"></span>
        <span class="ex-brand__text">
          <span class="ex-brand__name">SECURESHOP // ELITE</span>
          <span class="ex-brand__tag">VERIFIED DEFENSE PROTOCOL</span>
        </span>
      </a>
      <form class="ex-search" action="/products" method="GET" role="search">
        <span class="msi">search</span>
        <input class="ex-input" id="catalog-search" type="search" name="q" value="{{searchQuery}}" maxlength="100"
               placeholder="Search inventory, SKUs..." aria-label="Search products">
        <kbd>/</kbd>
      </form>
    </div>

    <nav class="ex-nav" aria-label="Main">
      {{! pages pass nav="catalog|cart|orders|admin" to highlight their link }}
      <a href="/products" class="{{#if (eq nav "catalog")}}is-active{{/if}}">Catalog</a>
      {{#if user}}
        <a href="/cart" class="{{#if (eq nav "cart")}}is-active{{/if}}">Cart</a>
        <a href="/orders" class="{{#if (eq nav "orders")}}is-active{{/if}}">Orders</a>
        {{#if (eq user.role "admin")}}<a href="/admin" class="{{#if (eq nav "admin")}}is-active{{/if}}">Admin</a>{{/if}}
      {{/if}}
    </nav>

    <div class="ex-actions">
      <div class="ex-pill">
        <span class="ex-dot ex-dot--pulse"></span>
        <span>OWASP TOP 10</span>
        <span class="sep">|</span>
        <span class="hl">CSRF ON</span>
      </div>
      {{#if user}}
        <a class="ex-btn ex-btn--emerald" href="/auth/profile">
          <span class="msi">verified_user</span><span class="ex-hide-sm">{{user.username}}</span>
        </a>
        <a class="ex-btn ex-btn--cyan" href="/cart">
          <span class="msi">shopping_bag</span><span>CART [<span id="cart-count">{{itemCount}}</span>]</span>
        </a>
      {{else}}
        <a class="ex-btn ex-btn--emerald" href="/auth/login"><span class="msi">login</span><span>LOGIN</span></a>
        <a class="ex-btn ex-btn--cyan ex-hide-sm" href="/auth/register">REGISTER</a>
      {{/if}}
    </div>
  </div>
</header>

<div class="ex-ticker">
  <div class="ex-container ex-ticker__inner">
    <div class="ex-ticker__group">
      <span class="ok"><span class="msi">lock</span><span>SESSION ENCRYPTED</span></span>
      <span class="sep ex-ticker__hide-sm">/</span>
      <span class="ex-ticker__hide-sm">CSRF TOKEN: ACTIVE</span>
      <span class="sep ex-ticker__hide-md">/</span>
      <span class="ex-ticker__hide-md">RATE LIMIT: ENFORCED</span>
    </div>
    <div class="ex-ticker__group">
      <span class="ex-ticker__hide-md">CURRENCY: <strong>$ USD</strong></span>
      {{#if user}}
        <span class="sep ex-ticker__hide-md">|</span>
        <span class="ex-ticker__user"><span class="msi">person</span>{{user.username}}</span>
        <span class="sep">|</span>
        <form action="/auth/logout" method="POST">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <button type="submit" class="ex-linkbtn">LOGOUT</button>
        </form>
      {{/if}}
    </div>
  </div>
</div>
